<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".LanguageSelectionActivity">

    <!-- Language Selection at the Top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Language: "
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/button_english"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="EN"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ngo_blue"/>

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#BBBBBB"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="4dp"/>

        <Button
            android:id="@+id/button_marathi"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="मराठी"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ngo_blue"/>
    </LinearLayout>

    <!-- Main Section: Role Selection / Registration -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="0dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="399dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Welcome to Kind Hands"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Select role to register"
                android:textColor="#666666"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRoleDonor"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/btncurve"
                android:text="Donor"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnRoleOrphanage"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/btncurve"
                android:text="Orphanage"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnRoleOldAge"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="32dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/btncurve"
                android:text="Old Age Home"
                android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
