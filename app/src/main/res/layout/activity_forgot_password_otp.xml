<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".ForgotPasswordOtpActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/tvOtpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify OTP"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Info text -->
    <TextView
        android:id="@+id/tvOtpInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="An OTP has been sent to your registered email address. Please enter it below."
        android:textAlignment="center"
        android:textColor="@color/secondary_text"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvOtpTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- OTP Input -->
    <EditText
        android:id="@+id/etOtp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="Enter 6-digit OTP"
        android:inputType="number"
        android:maxLength="6"
        android:gravity="center"
        android:textSize="18sp"
        android:padding="14dp"
        android:background="@drawable/edittext_bg"
        app:layout_constraintTop_toBottomOf="@id/tvOtpInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Verify Button -->
    <Button
        android:id="@+id/btnVerifyOtp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Verify OTP"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:padding="14dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/ngo_blue"
        app:layout_constraintTop_toBottomOf="@id/etOtp"
        app:layout_constraintStart_toStartOf="@id/etOtp"
        app:layout_constraintEnd_toEndOf="@id/etOtp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
