<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOrgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organization Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/ngo_blue"/>

        <TextView
            android:id="@+id/tvOrgType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type: Education"
            android:layout_marginTop="4dp"
            android:textStyle="italic"/>

        <TextView
            android:id="@+id/tvOrgAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address: 123 Main St, City"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvOrgContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact: +1234567890"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
